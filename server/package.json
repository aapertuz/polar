    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": { "fastify": "^5.12.5" },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
