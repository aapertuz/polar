{
  "name": "@polar/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --watch-path=src --import tsx src/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
