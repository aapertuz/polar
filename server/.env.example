# Copy to the repository root .env.development.local for development.
# Production uses .env.production.local or explicitly scoped deployment variables.
POLAR_ENV=development
NEON_BRANCH=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@DEVELOPMENT_POOLER_HOST/polar_development?sslmode=verify-full
# Prefer the direct, non-pooled Neon URL for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DEVELOPMENT_DIRECT_HOST/polar_development?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
POLAR_DESKTOP_CLIENT_ID=com.antoniopertuz.polar.desktop.development
# Production mission workflows require both Inngest Cloud keys.
# INNGEST_EVENT_KEY=replace-with-production-event-key
# INNGEST_SIGNING_KEY=replace-with-production-signing-key
# Production: POLAR_ENV/NEON_BRANCH=production, database=polar_production,
# production endpoint, independent secret, HTTPS origin, and client ID
# com.antoniopertuz.polar.desktop. See docs/AUTHENTICATION.md.
