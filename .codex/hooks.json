{
  "description": "Polar project context, formatting, and documentation feedback.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "timeout": 15,
            "statusMessage": "Loading Polar plan context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "timeout": 60,
            "statusMessage": "Formatting changed source and checking Polar documentation"
          }
        ]
      }
    ]
  }
}
