#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Deleting remote refs alone needs no build. Consume Git's ref-update input.
verify=false
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    ''|*[!0]*) verify=true ;;
  esac
done
if [ "$verify" = true ]; then
  exec pnpm verify
fi
